<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd LaunchAgent for the puppy daemon. Install: see docs/service.md
    cp packaging/launchd/dev.puppy.daemon.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.puppy.daemon.plist
  Starts ~/.local/bin/puppy (where the install script puts it). launchd does not
  expand "~", so a shell expands $HOME; exec keeps the PID for KeepAlive.
  Edit the command if puppy is installed elsewhere.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.puppy.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec "$HOME/.local/bin/puppy" daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
