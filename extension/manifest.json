{
  "manifest_version": 3,
  "name": "puppy",
  "version": "0.2.0",
  "description": "Hands browser downloads to the puppy download manager",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "puppy",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "bypass-next": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Let the browser take the next download"
    }
  }
}
